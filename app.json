{
  "expo": {
    "name": "Cazé TV",
    "slug": "caze-tv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logos/caze.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/logos/caze.png",
      "resizeMode": "contain",
      "backgroundColor": "#0047BB"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logos/caze.png",
        "backgroundColor": "#0047BB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cazetv"
    },
    "web": {
      "favicon": "./src/assets/images/logos/caze.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "20085498-48fb-4f60-a36a-5bfceb97c28c"
      }
    }
  }
}
