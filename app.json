{
  "expo": {
    "name": "Cazé TV",
    "slug": "Cazé TV",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logos/caze.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/logos/caze.png",
      "resizeMode": "contain",
      "backgroundColor": "#0047BB"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logos/caze.png",
        "backgroundColor": "#0047BB"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./src/assets/images/logos/caze.png"
    }
  }
}
